# Endereço da API Spring Boot, lido pelo servidor Next (todas as chamadas partem do servidor;
# o navegador nunca recebe o token JWT). Em containers, use o host interno do backend.
API_URL=http://localhost:8080/api

# Mantida por compatibilidade com o frontend N1. Usada apenas se API_URL não estiver definida.
# NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Fuso horário usado na exibição de datas (a API trabalha em UTC).
NEXT_PUBLIC_TIME_ZONE=America/Sao_Paulo

# Só para testar o build de produção sem HTTPS em localhost: grava o cookie de sessão sem "Secure".
# COOKIE_INSECURE=true
