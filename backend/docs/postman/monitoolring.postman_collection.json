{
  "info": {
    "_postman_id": "6f1d2c1e-3b8a-4f0e-9c55-6d2a0b7e4a10",
    "name": "Monitoolring API (N2)",
    "description": "Coleção da API do backend Monitoolring. Pré-requisito: API rodando (ver backend/README.md). Rode a coleção inteira em ordem (Runner ou newman): os requests de login gravam `token` (Staff) e `memberToken` (Membro), e o cadastro de ferramenta grava `toolId`/`toolVersao`. E-mails e códigos são gerados por execução, então a coleção pode rodar várias vezes no mesmo banco.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "description": "Rota pública de verificação da API.",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"status UP\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Autocadastro de Membro, login e logout (FR-1). Rode \"Login Staff (bootstrap)\" primeiro: ele grava `token`, usado por toda a coleção.",
      "item": [
        {
          "name": "Login Staff (bootstrap)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const login = pm.response.json();",
                  "pm.test(\"papel STAFF e token Bearer\", function () {",
                  "    pm.expect(login.tipo).to.eql(\"Bearer\");",
                  "    pm.expect(login.usuario.papel).to.eql(\"STAFF\");",
                  "});",
                  "pm.collectionVariables.set(\"token\", login.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login com o Staff criado pelo bootstrap (APP_BOOTSTRAP_STAFF_*). Salva o token em `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"senha\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Registrar Membro",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// e-mail único por execução, para a coleção poder rodar várias vezes no mesmo banco",
                  "pm.collectionVariables.set(\"memberEmail\", \"membro.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"conta criada como MEMBER, sem senha na resposta\", function () {",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.papel).to.eql(\"MEMBER\");",
                  "    pm.expect(user).to.not.have.property(\"senha\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
