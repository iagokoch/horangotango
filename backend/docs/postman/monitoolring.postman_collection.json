    {
      "name": "Tools",
      "description": "Catálogo de Ferramentas (FR-3, FR-4, FR-5). Escrita só para Staff; leitura para Membro e Staff.",
      "item": [
        {
          "name": "Cadastrar ferramenta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// código único por execução (máx. 18 caracteres)",
                  "pm.collectionVariables.set(\"toolCodigo\", \"PM\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const tool = pm.response.json();",
                  "pm.test(\"nasce AVAILABLE com versao 0\", function () {",
                  "    pm.expect(tool.status).to.eql(\"AVAILABLE\");",
                  "    pm.expect(tool.versao).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set(\"toolId\", tool.id);",
                  "pm.collectionVariables.set(\"toolVersao\", tool.versao);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
